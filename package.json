{
  "name": "igm",
  "version": "1.0.0",
  "description": "Instagram CLI engine",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "igm": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:userscript": "esbuild src/modules/messaging/services/automation/userscript/main.ts --bundle --outfile=dist/assets/idmu.user.js",
    "build": "tsup && npm run build:userscript",
    "build:exe": "node scripts/build-exe.mjs",
    "prepack": "npm run build",
    "test": "vitest run",
    "prepare": "husky"
  },
  "keywords": [
    "instagram",
    "cli",
    "terminal"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "axios": "^1.16.1",
    "blessed": "^0.1.81",
    "chalk": "^4.1.2",
    "conf": "^15.1.0",
    "got-scraping": "^4.2.1",
    "playwright": "^1.62.1",
    "string-width": "^4.2.3",
    "yargs": "^18.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/blessed": "^0.1.27",
    "@types/conf": "^2.1.0",
    "@types/node": "^25.9.5",
    "@types/yargs": "^17.0.35",
    "esbuild": "^0.20.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "postject": "^1.0.0-alpha.6",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
